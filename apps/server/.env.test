# Committed test environment. Loaded by the test harness (test/setup/env.ts) and by
# the config module when NODE_ENV is test. dotenv never overrides a variable that is
# already set, so CI overrides only TEST_DATABASE_URL.
NODE_ENV=test

# The disposable Postgres from compose.yml. Never DATABASE_URL: the harness copies
# this value into DATABASE_URL itself and refuses any host other than localhost.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sunday_heroes_test

# Dummy values for every variable the config module refuses to start without.
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
JWT_APP_ACCESS_SECRET=test-jwt-access-secret
JWT_APP_REFRESH_SECRET=test-jwt-refresh-secret
PRODUCTION_URL=http://localhost:3001
DEV_SERVER_URL=http://localhost:3001
DEV_CLIENT_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test-smtp-user
SMTP_PASSWORD=test-smtp-password
