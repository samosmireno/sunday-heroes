# Committed test environment. Vitest runs Vite in mode "test", so Vite loads this
# file on top of the developer's gitignored .env, and a mode-specific file wins over
# the generic one. Every value the config module warns about is set here, so the
# client tests read the same absolute server URL locally and in CI.
VITE_MODE=test
VITE_CLIENT_ID=test-google-client-id
VITE_SERVER_DEV_URL=http://localhost:3001
VITE_SERVER_PROD_URL=http://localhost:3001
